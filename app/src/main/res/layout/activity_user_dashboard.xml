<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboardDrawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cinema_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/dashboardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cinema_bg"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/dashboardToolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#F209090B"
            android:elevation="0dp"
            android:navigationIcon="@drawable/ic_menu"
            android:title="@string/cinema_brand"
            android:subtitle="@string/cinema_player"
            android:titleTextColor="@color/cinema_text"
            android:subtitleTextColor="@color/cinema_muted"
            app:navigationIconTint="@color/cinema_text" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1FFFFFFF" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/dashboardScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="44dp">

                <TextView
                    android:id="@+id/dashboardEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/personal_space"
                    android:textAllCaps="true"
                    android:textColor="@color/cinema_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dashboardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/dashboard_welcome"
                    android:textColor="@color/cinema_text"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/dashboard_subtitle"
                    android:textColor="@color/cinema_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/serverStatusCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_cinema_panel_dark"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/serverStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_cinema_status_warn"
                        android:paddingStart="9dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="5dp"
                        android:text="@string/server_checking"
                        android:textColor="#FBBF24"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/serverStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/server_connecting"
                            android:textColor="@color/cinema_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/serverMetaText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/server_meta_waiting"
                            android:textColor="@color/cinema_muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/serverProgress"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:indeterminateTint="@color/cinema_primary" />

                    <TextView
                        android:id="@+id/serverRetryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/retry"
                        android:textColor="@color/cinema_primary"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="142dp"
                            android:layout_height="94dp"
                            android:background="@drawable/bg_cinema_stat"
                            android:orientation="vertical"
                            android:padding="15dp">
                            <TextView android:id="@+id/statLibrary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/cinema_text" android:textSize="28sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/my_library" android:textColor="@color/cinema_muted" android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="142dp"
                            android:layout_height="94dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_cinema_stat"
                            android:orientation="vertical"
                            android:padding="15dp">
                            <TextView android:id="@+id/statWatchlist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/cinema_text" android:textSize="28sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/watchlist" android:textColor="@color/cinema_muted" android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="142dp"
                            android:layout_height="94dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_cinema_stat"
                            android:orientation="vertical"
                            android:padding="15dp">
                            <TextView android:id="@+id/statWatched" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/cinema_text" android:textSize="28sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/watched_label" android:textColor="@color/cinema_muted" android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="142dp"
                            android:layout_height="94dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_cinema_stat"
                            android:orientation="vertical"
                            android:padding="15dp">
                            <TextView android:id="@+id/statRatings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/cinema_text" android:textSize="28sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/my_ratings" android:textColor="@color/cinema_muted" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/tmdbSearchCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_cinema_glass"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/add_from_tmdb"
                        android:textColor="@color/cinema_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/tmdb_private_library_hint"
                        android:textColor="@color/cinema_muted"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/tmdbSearchInput"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_cinema_search"
                            android:hint="@string/tmdb_search_hint"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="@color/cinema_text"
                            android:textColorHint="@color/cinema_muted" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tmdbSearchButton"
                            android:layout_width="wrap_content"
                            android:layout_height="52dp"
                            android:layout_marginStart="8dp"
                            android:text="@string/search"
                            android:textAllCaps="false"
                            android:textColor="@color/cinema_text"
                            app:backgroundTint="@color/cinema_primary_soft"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/cinema_primary"
                            app:strokeWidth="1dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tmdbSearchState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <ProgressBar
                            android:id="@+id/tmdbSearchProgress"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:indeterminateTint="@color/cinema_primary" />
                        <TextView
                            android:id="@+id/tmdbSearchMessage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:textColor="@color/cinema_muted"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeSections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/continueSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <TextView style="@style/Dashboard.SectionTitle" android:text="@string/continue_watching" />
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/continueList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:clipToPadding="false"
                            android:overScrollMode="never" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/watchlistHomeSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <TextView style="@style/Dashboard.SectionTitle" android:text="@string/watchlist_title" />
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/watchlistHomeList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:clipToPadding="false"
                            android:overScrollMode="never" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/recentHomeSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <TextView style="@style/Dashboard.SectionTitle" android:text="@string/recent_title" />
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recentHomeList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:clipToPadding="false"
                            android:overScrollMode="never" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/catalogHomeSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <TextView style="@style/Dashboard.SectionTitle" android:text="@string/public_catalog_title" />
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/catalogHomeList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:clipToPadding="false"
                            android:overScrollMode="never" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/homeEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/bg_cinema_panel_dark"
                        android:gravity="center"
                        android:padding="24dp"
                        android:text="@string/dashboard_home_empty"
                        android:textColor="@color/cinema_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/listSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/dashboardSectionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/my_library"
                            android:textColor="@color/cinema_text"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/dashboardSectionCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_cinema_badge"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:text="0"
                            android:textColor="@color/cinema_text"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dashboardEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_cinema_panel_dark"
                        android:gravity="center"
                        android:padding="28dp"
                        android:text="@string/empty_personal_library"
                        android:textColor="@color/cinema_muted"
                        android:textSize="12sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/dashboardMovies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <ScrollView
        android:id="@+id/dashboardSidebar"
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FC0C1119"
        android:fitsSystemWindows="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/sidebarItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="26dp"
            android:paddingEnd="16dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cinema_brand_with_play"
                android:textColor="@color/cinema_text"
                android:textSize="25sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:letterSpacing="0.22"
                android:text="@string/cinema_player"
                android:textColor="@color/cinema_muted"
                android:textSize="8sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_cinema_panel_dark"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:id="@+id/sidebarAccountName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guest_account"
                    android:textColor="@color/cinema_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/sidebarSyncStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/local_library"
                    android:textColor="@color/cinema_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView android:id="@+id/navDashboard" style="@style/Dashboard.NavItem" android:text="@string/nav_dashboard" />
            <TextView android:id="@+id/navCatalog" style="@style/Dashboard.NavItem" android:text="@string/nav_public_catalog" />

            <TextView style="@style/Dashboard.NavSection" android:text="@string/my_library" />
            <TextView android:id="@+id/navLibrary" style="@style/Dashboard.NavItem" android:text="@string/nav_my_library" />
            <TextView android:id="@+id/navWatchlist" style="@style/Dashboard.NavItem" android:text="@string/nav_watchlist" />
            <TextView android:id="@+id/navRecent" style="@style/Dashboard.NavItem" android:text="@string/nav_recent" />
            <TextView android:id="@+id/navRatings" style="@style/Dashboard.NavItem" android:text="@string/nav_ratings" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_cinema_panel_dark"
                android:orientation="vertical"
                android:padding="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/recent_title"
                        android:textColor="@color/cinema_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/sidebarHistoryCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_cinema_badge"
                        android:paddingStart="7dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="2dp"
                        android:text="0"
                        android:textColor="@color/cinema_text"
                        android:textSize="9sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/sidebarRecentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView style="@style/Dashboard.NavSection" android:text="@string/account_short" />
            <TextView android:id="@+id/navPlayer" style="@style/Dashboard.NavItem" android:text="@string/back_to_player" />
            <TextView android:id="@+id/navAdmin" style="@style/Dashboard.NavItem" android:text="@string/admin_dashboard" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>
