<resources>
    <style name="Base.Theme.AnyMovie" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/matte_primary</item>
        <item name="colorOnPrimary">@color/matte_on_primary</item>
        <item name="colorPrimaryContainer">@color/matte_primary_container</item>
        <item name="colorSecondary">@color/matte_secondary</item>
        <item name="colorSecondaryContainer">@color/matte_secondary_container</item>
        <item name="colorTertiary">@color/matte_tertiary</item>
        <item name="colorSurface">@color/matte_surface</item>
        <item name="colorSurfaceVariant">@color/matte_surface_variant</item>
        <item name="colorOnSurface">@color/matte_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/matte_on_surface_variant</item>
        <item name="colorOutline">@color/matte_outline</item>
        <item name="colorError">@color/matte_error</item>
        <item name="android:colorAccent">@color/matte_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/matte_background</item>
        <item name="android:navigationBarColor">@color/matte_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.AnyMovie.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.AnyMovie.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.AnyMovie.Large</item>
    </style>
    <style name="Theme.AnyMovie" parent="Base.Theme.AnyMovie" />
    <style name="ShapeAppearance.AnyMovie.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">14dp</item>
    </style>
    <style name="ShapeAppearance.AnyMovie.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.AnyMovie.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">28dp</item>
    </style>
    <style name="Theme.AnyMovie.Dashboard" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/cinema_primary</item>
        <item name="colorOnPrimary">@color/cinema_text</item>
        <item name="colorSurface">@color/cinema_surface</item>
        <item name="colorOnSurface">@color/cinema_text</item>
        <item name="android:statusBarColor">@color/cinema_bg</item>
        <item name="android:navigationBarColor">@color/cinema_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Dashboard" />
    <style name="Dashboard.NavItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:background">@drawable/bg_cinema_nav</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/cinema_text</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Dashboard.NavSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:textColor">@color/cinema_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Dashboard.SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/cinema_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="ThemeOverlay.AnyMovie.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorPrimary">@color/cinema_primary</item>
        <item name="colorSurface">@color/cinema_surface</item>
        <item name="colorOnSurface">@color/cinema_text</item>
        <item name="android:navigationBarColor">@color/cinema_bg</item>
    </style>
</resources>