<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The app discovers media on the open web, including legacy HTTP CDNs.
         Private/local hosts are still rejected by the server-side SSRF guard. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
